{
  "name": "vue-summon",
  "version": "0.0.0",
  "description": "Imperatively render Vue components from anywhere — dialogs, toasts, modals, without cluttering your templates.",
  "keywords": [
    "dialog",
    "imperative",
    "modal",
    "summon",
    "toast",
    "vue"
  ],
  "license": "MIT",
  "author": "litingyes",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "vue-component-type-helpers": "^3.3.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/browser-preview": "^4.1.10",
    "bumpp": "^12.1.1",
    "changelogen": "^0.6.2",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.6",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "^4.1.10",
    "vitest-browser-vue": "^2.1.0"
  },
  "peerDependencies": {
    "vue": "3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.18.0"
}
